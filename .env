# ================================================================
# RGNODES VPS BOT - EASY CONFIG
# ================================================================
# FILL ONLY THESE TWO LINES TO START:
#   DISCORD_TOKEN  = Discord Developer Portal -> your app -> Bot -> Reset Token
#   MAIN_ADMIN_ID  = your numeric Discord user ID (Developer Mode -> right click you -> Copy User ID)
# Everything else already has safe defaults. setup.sh also asks for these two
# values (token input is hidden) and auto-detects PUBLIC_PARENT_INTERFACE.
#
# SECURITY: never commit a filled copy. .gitignore already excludes .env, and setup.sh keeps a
# private backup in /var/lib/rgnodes-vps/data/env.backup so re-cloning never loses your token.
# ================================================================

# -------------------- Discord --------------------
DISCORD_TOKEN=
MAIN_ADMIN_ID=
ADMIN_USER_IDS=
VPS_USER_ROLE_ID=

# -------------------- Bot identity --------------------
BOT_NAME=RGNODES™
PREFIX=-
BOT_VERSION=15.2.0
BOT_DEVELOPER=RGNODES™
HOST_PROVIDER_NAME=RGNODES™
HOST_PROCESSOR_NAME=RGNODES™ Powerfull Free
VPS_HOSTNAME=rgnodes-vps

# -------------------- VPS backend --------------------
# Customer product: VPS only. KVM/QEMU/libvirt is the virtualization backend.
VPS_ENABLED=true
VPSCTL_PATH=/usr/local/sbin/vpsctl
RGNODES_VPS_ROOT=/var/lib/rgnodes-vps
# Database + backups live here (outside the git checkout) so re-cloning never wipes data.
# Leave blank to use <RGNODES_VPS_ROOT>/data.
RGNODES_DATA_DIR=

# -------------------- Resource policy --------------------
# New VPS starts small and can grow only within its hard maximum.
MIN_VPS_RAM_GB=1
INITIAL_VPS_RAM_GB=1
DEFAULT_VPS_RAM_GB=1
MAX_VPS_RAM_GB=8
INITIAL_VPS_CPU=1
DEFAULT_VPS_CPU=2
MAX_VPS_CPU=8
MIN_VPS_DISK_GB=10
INITIAL_VPS_DISK_GB=10
DEFAULT_VPS_STORAGE_GB=25
MAX_VPS_DISK_GB=100
AUTO_RESOURCE_ALLOCATION=true
RESOURCE_AUTOSCALE_ENABLED=true
RESOURCE_AUTOSCALE_INTERVAL=30
RESOURCE_SCALE_UP_RAM_THRESHOLD=80
RESOURCE_SCALE_UP_CPU_THRESHOLD=85
RESOURCE_SCALE_UP_DISK_THRESHOLD=80
RESOURCE_SCALE_UP_DISK_STEP_GB=10

# -------------------- Per-VPS host protection (applied to every NEW VPS) --------------------
# Disk I/O caps stop one VPS from saturating the host disk. 0 disables a cap.
VPS_DISK_IOPS_LIMIT=8000
VPS_DISK_MBPS_LIMIT=400
# Optional network cap per VPS in Mbit/s (0 = unlimited).
VPS_NET_LIMIT_MBPS=0

# -------------------- Host safety guards --------------------
# Maximum reservations are admitted before deploy/resize so the node cannot overcommit.
HOST_RAM_RESERVE_GB=2
HOST_CPU_RESERVE=1
HOST_DISK_RESERVE_GB=10
HOST_CPU_MAX_DEPLOY_PCT=85
MIN_HOST_RAM_FREE_PCT_DEPLOY=18
MAX_DEPLOY_RAM_SHARE=0.80
DEPLOY_EXECUTION_TIMEOUT=1800
GUEST_BOOTSTRAP_TIMEOUT=600

# -------------------- Public IPv4 networking --------------------
# direct = macvtap/direct attachment to the detected provider uplink.
# bridge = use a provider-created public Linux bridge.
KVM_NETWORK_MODE=direct
PUBLIC_PARENT_INTERFACE=
PUBLIC_BRIDGE_NAME=
REAL_PUBLIC_IPV4_REQUIRED=true

# Optional routed public IPv4 pool. Use ONLY when your provider routed this subnet to the node.
PUBLIC_IPV4_POOL_CIDR=
PUBLIC_IPV4_GATEWAY=
PUBLIC_IPV4_DNS=1.1.1.1,8.8.8.8
PUBLIC_IPV4=
PUBLIC_IPV6=
AUTO_DETECT_PUBLIC_IP=true

# -------------------- Guest protection --------------------
ANTI_MINING_ENABLED=true
# Outbound TCP ports blocked inside every new VPS (common mining-pool ports). Comma separated.
ANTI_MINING_BLOCK_PORTS=3333,4444,5555,7777,14433,14444
DOCKER_INSTALL_ON_DEPLOY=true
DOCKER_STRICT_DEPLOY=false
VPS_SWAP_ENABLED=false

# -------------------- SSH / SSHX / Pinggy --------------------
PINGGY_ENABLED=true
PINGGY_AUTO_START=true
PINGGY_HOST=free.pinggy.io
PINGGY_SSH_PORT=802
SSHX_ENABLED=true
SSHX_DIRECT_FALLBACK=true
SSHX_START_RETRIES=3
SSHX_SESSION_WAIT_SECONDS=75
SSHX_ACTION_TIMEOUT=180
SSHX_INSTALL_RETRIES=3
TUNNEL_REPAIR_INTERVAL=600
ACCESS_REPAIR_INTERVAL=600

# -------------------- Port / lifecycle --------------------
DEFAULT_PORT_QUOTA=10
PORT_HOST_MIN=20000
PORT_HOST_MAX=50000
VPS_RENEWAL_DAYS=60
DEFAULT_VPS_EXPIRATION_DAYS=60
RENEWAL_WINDOW_DAYS=2
EXPIRATION_WARNING_DAYS=2
AUTOSAVE_INTERVAL=60
LOG_HEALTH_INTERVAL=900
HOST_STATS_CACHE_TTL=8
BANDWIDTH_SAMPLE_INTERVAL=600
BOT_AUTO_RESTART=false
BOT_RESTART_DELAY=8

# -------------------- Discord UI --------------------
# Embeds are intentionally colorless.
BOT_THUMBNAIL_URL=https://cdn.discordapp.com/icons/1503614184477167616/f1534b0b4cb22ff19872549b8a52d59f.webp?size=2048
BOT_ICON_URL=https://cdn.discordapp.com/icons/1503614184477167616/f1534b0b4cb22ff19872549b8a52d59f.webp?size=2048
AUTO_CREATE_SERVER_EMOJIS=true

# -------------------- Animated/custom emoji names --------------------
EMOJI_ONLINE=StatusOnline
EMOJI_STATUS=StatusOnline
EMOJI_VPS=rgnodes_vps
EMOJI_DEPLOY=rgnodes_deploy
EMOJI_ROCKET=rgnodes_rocket
EMOJI_SERVER=rgnodes_server
EMOJI_CPU=rgnodes_cpu
EMOJI_RAM=rgnodes_ram
EMOJI_DISK=rgnodes_disk
EMOJI_NETWORK=rgnodes_network
EMOJI_DOCKER=rgnodes_docker
EMOJI_SSH=rgnodes_ssh
EMOJI_SSHX=rgnodes_sshx
EMOJI_PORTS=rgnodes_ports
EMOJI_PASSWORD=rgnodes_password
EMOJI_REINSTALL=rgnodes_reinstall
EMOJI_RENEW=rgnodes_renew
EMOJI_START=rgnodes_start
EMOJI_STOP=rgnodes_stop
EMOJI_STATS=rgnodes_stats
EMOJI_REFRESH=rgnodes_refresh
EMOJI_DELETE=rgnodes_delete
EMOJI_SUCCESS=rgnodes_success
EMOJI_WARNING=rgnodes_warning
EMOJI_ERROR=StatusOffline
EMOJI_OFFLINE=StatusOffline
EMOJI_LOADING=Loading
EMOJI_MAINTENANCE=WiFi_Maintenance
EMOJI_PINGGY=WiFi_Online
EMOJI_PINGGY_OFFLINE=WiFi_Offline

# -------------------- Guest MOTD --------------------
# Automatically installs an embedded safe RGNODES MOTD on every new/running guest.
# Displays RGNODES banner + live OS/CPU/RAM/disk/IP stats on interactive SSH login.
# Deliberately does NOT curl|bash the upstream script: that script edits PAM,
# disables default update-motd hooks and deletes /etc/motd. This version preserves them.
# Source reviewed: https://raw.githubusercontent.com/mrzetrixyt-525/vm-/main/MOTD-Installer
AUTO_MOTD_INSTALLER=true
HOST_MOTD=Welcome to RGNODES. Authorized access only.
